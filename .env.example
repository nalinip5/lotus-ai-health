# --- LLM provider -----------------------------------------------------------
# mock (offline, deterministic) | openai | azure_openai | anthropic
LOTUS_LLM_PROVIDER=mock
LOTUS_LLM_MODEL=
LOTUS_LLM_API_KEY=
# azure_openai: https://<resource>.openai.azure.com   (LOTUS_LLM_MODEL = deployment name)
LOTUS_LLM_BASE_URL=
LOTUS_AZURE_API_VERSION=2024-10-21
# Back-pressure: max concurrent LLM calls across all workflows
LOTUS_LLM_MAX_CONCURRENCY=8

# --- Storage ----------------------------------------------------------------
LOTUS_DATA_DIR=./.lotus-data

# --- Synthetic live feed ----------------------------------------------------
LOTUS_SIMULATOR=1
LOTUS_SIM_INTERVAL=6
LOTUS_SEED=7

# --- Observability (optional; pip install '.[otel]') -------------------------
# OTLP/HTTP endpoint, e.g. Arize's collector
LOTUS_OTEL_ENDPOINT=
