# --- LLM provider -----------------------------------------------------------
# mock (offline, deterministic) | openai | azure_openai | anthropic
LOTUS_LLM_PROVIDER=mock
LOTUS_LLM_MODEL=
LOTUS_LLM_API_KEY=
# azure_openai: https://<resource>.openai.azure.com   (LOTUS_LLM_MODEL = deployment name)
LOTUS_LLM_BASE_URL=
LOTUS_AZURE_API_VERSION=2024-10-21
# Back-pressure: max concurrent LLM calls across all workflows
LOTUS_LLM_MAX_CONCURRENCY=8

# --- Storage ----------------------------------------------------------------
LOTUS_DATA_DIR=./.lotus-data

# --- Synthetic live feed ----------------------------------------------------
LOTUS_SIMULATOR=1
LOTUS_SIM_INTERVAL=6
LOTUS_SEED=7

# --- Observability (optional; pip install '.[otel]') -------------------------
# OTLP/HTTP endpoint, e.g. Arize's collector
LOTUS_OTEL_ENDPOINT=

# --- Staff sign-in -----------------------------------------------------------
# 1 = open demo mode (no sign-in, everyone acts as admin); 0 = require admin/staff sign-in
LOTUS_AUTH_DISABLED=0
# First admin, created on first start. If LOTUS_ADMIN_PASSWORD is empty a random
# password is generated and printed once in the server log.
LOTUS_ADMIN_EMAIL=admin@lotusbpmhealth.com
LOTUS_ADMIN_NAME=Lotus Admin
LOTUS_ADMIN_PASSWORD=
# Signs session cookies; set a long random value in production
LOTUS_SESSION_SECRET=

# --- Visit-to-Claim ingest (telehealth platform → Lotus AI Health) -----------
# Bearer token for POST /api/ingest/visits; ingest is disabled when empty
LOTUS_INGEST_TOKEN=
